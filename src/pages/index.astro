---
import KnowledgeApp from '../app/KnowledgeApp';
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="从 Transformer 出发，用大白话理解 NLP、CV、Audio、Omni 的结构、训练、评测与实践闭环。"
    />
    <meta name="theme-color" content="#f8fafb" />
    <title>模型知识地图 · 从 Transformer 出发</title>
    <link rel="icon" href="data:," />
  </head>
  <body>
    <KnowledgeApp client:only="react" dataUrl={`${base}data/atlas.json`} base={base} />
    <noscript>
      <p>
        交互地图需要 JavaScript。你仍可以
        <a href={`${base}foundations/transformer/`}>从 Transformer 正文开始阅读</a>。
      </p>
    </noscript>
  </body>
</html>
